# ARIA v5 — Environment Variables
OWM_API_KEY=          # openweathermap.org (free tier)
NTFY_TOPIC=           # override auto-generated topic
TELEGRAM_TOKEN=       # from @BotFather
TELEGRAM_CHAT=        # your chat_id
LINE_TOKEN=           # notify-bot.line.me
CALLMEBOT_PHONE=      # +66xxxxxxxxx
CALLMEBOT_KEY=        # callmebot.com
PORT=5000
MESH_PORT=47777

# ── THREAT MONITOR (War & Economic Surveillance) ──
THREAT_MONITOR=1          # 1=enabled, 0=disabled
MONITOR_INTERVAL=300      # scan every 5 minutes (seconds)
WAR_THRESHOLD=7.0         # earthquake M >= this → alert
ECON_CRASH_PCT=-5.0       # crypto/stock drop % → alert (e.g. -5 = 5% drop)
KP_THRESHOLD=5.0          # geomagnetic K-index >= this → alert
FIRE_ALERT_COUNT=500      # NASA fire point count → alert
THREAT_ALERT_CHANNEL=ntfy # ntfy|telegram|line|whatsapp|all

# ── Bot Bridges ──
DISCORD_TOKEN=            # Discord bot token (discord.com/developers)
DISCORD_CHANNEL=          # Discord channel ID
LINE_CHANNEL_SECRET=      # LINE Messaging API channel secret
LINE_ACCESS_TOKEN=        # LINE Messaging API access token

# ── Agent & RAG ──
AGENT_MODEL=qwen2.5:7b   # Ollama model for agent
RAG_MODEL=qwen2.5:7b     # Ollama model for RAG answers
EMBED_MODEL=nomic-embed-text  # Ollama embedding model (optional)
MEMORY_DB=aria_memory.db
RAG_DB=aria_rag.db
SCHEDULER_DB=aria_scheduler.db

# ── E2E Encrypted Chat ──
# CRYPTO_SALT and CRYPTO_KEY are auto-generated on first /echat setup
# Share the key fingerprint (not the key itself) with peers to verify
